    IF CM_AIN[11].PV <= CM_AIN[11].LAL  AND CM_AIN[11].LEN  AND CM_AIN[11].LEN_PRG  THEN CM_AIN[11].LAI  := 1; END_IF;
    IF CM_AIN[11].PV <= CM_AIN[11].LLAL AND CM_AIN[11].LLEN AND CM_AIN[11].LLEN_PRG THEN CM_AIN[11].LLAI := 1; END_IF;
END_IF;
