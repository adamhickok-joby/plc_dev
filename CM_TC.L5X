IF CM_AIN[12].PV > (CM_AIN[12].LLAL + CM_AIN[12].ALMDB) THEN CM_AIN[12].LLAI := 0; END_IF;
IF CM_AIN[12].BAD THEN CM_AIN[12].HHAI := 0; CM_AIN[12].HAI := 0; CM_AIN[12].LAI := 0; CM_AIN[12].LLAI := 0; END_IF;
CM_AIN[12].ALARM := CM_AIN[12].HHAI OR CM_AIN[12].HAI OR CM_AIN[12].LAI OR CM_AIN[12].LLAI;
IF CM_AIN[12].HHAI THEN CM_AIN[12].ALMpri := 1;
ELSIF CM_AIN[12].LLAI THEN CM_AIN[12].ALMpri := 2;
ELSIF CM_AIN[12].HAI  THEN CM_AIN[12].ALMpri := 3;
ELSIF CM_AIN[12].LAI  THEN CM_AIN[12].ALMpri := 4;
ELSE CM_AIN[12].ALMpri := 5;
END_IF;
IF CM_AIN[12].ACK THEN CM_AIN[12].ACKD := 1; CM_AIN[12].BLINK := 0; CM_AIN[12].ACK := 0; END_IF;

(* ---- Channel 13 (Slot 5 Ch01) ---- *)
CM_AIN[13].PV := INT_TO_REAL(CM_AIN[13].IN);
IF CM_AIN[13].MODE THEN CM_AIN[13].PV := CM_AIN[13].PV_SIM; END_IF;
CM_AIN[13].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[13].ALARMTIME * 1000.0);
