IF CM_AIN[11].BAD THEN CM_AIN[11].HHAI := 0; CM_AIN[11].HAI := 0; CM_AIN[11].LAI := 0; CM_AIN[11].LLAI := 0; END_IF;
CM_AIN[11].ALARM := CM_AIN[11].HHAI OR CM_AIN[11].HAI OR CM_AIN[11].LAI OR CM_AIN[11].LLAI;
IF CM_AIN[11].HHAI THEN CM_AIN[11].ALMpri := 1;
ELSIF CM_AIN[11].LLAI THEN CM_AIN[11].ALMpri := 2;
ELSIF CM_AIN[11].HAI  THEN CM_AIN[11].ALMpri := 3;
ELSIF CM_AIN[11].LAI  THEN CM_AIN[11].ALMpri := 4;
ELSE CM_AIN[11].ALMpri := 5;
END_IF;
IF CM_AIN[11].ACK THEN CM_AIN[11].ACKD := 1; CM_AIN[11].BLINK := 0; CM_AIN[11].ACK := 0; END_IF;

