    IF CM_AIN[12].PV >= CM_AIN[12].HHAL AND CM_AIN[12].HHEN AND CM_AIN[12].HHEN_PRG THEN CM_AIN[12].HHAI := 1; END_IF;
    IF CM_AIN[12].PV >= CM_AIN[12].HAL  AND CM_AIN[12].HEN  AND CM_AIN[12].HEN_PRG  THEN CM_AIN[12].HAI  := 1; END_IF;
    IF CM_AIN[12].PV <= CM_AIN[12].LAL  AND CM_AIN[12].LEN  AND CM_AIN[12].LEN_PRG  THEN CM_AIN[12].LAI  := 1; END_IF;
    IF CM_AIN[12].PV <= CM_AIN[12].LLAL AND CM_AIN[12].LLEN AND CM_AIN[12].LLEN_PRG THEN CM_AIN[12].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[12].PV < (CM_AIN[12].HHAL - CM_AIN[12].ALMDB) THEN CM_AIN[12].HHAI := 0; END_IF;
IF CM_AIN[12].PV < (CM_AIN[12].HAL  - CM_AIN[12].ALMDB) THEN CM_AIN[12].HAI  := 0; END_IF;
