<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.00" TargetName="GeneralPanel_Foundation" TargetType="Controller" ContainsContext="true">
  <Controller Use="Context" Name="GeneralPanel_Foundation">
    <Programs Use="Context">
      <Program Name="MainProgram" Use="Context">
        <Routines Use="Context">

          <Routine Name="CM_TC" Type="ST">
            <STContent>
              <![CDATA[
(* ============================================================
   CM_TC — Thermocouple input processing (Slots 4-6 IY4)
   Channels: CM_AIN[8..19]
   Scaling: pass-through only (PV := INT_TO_REAL(IN))
   All alarm, deadband, BAD, ALMpri, ACK/ACKD logic
   identical to CM_AI.
   ============================================================ *)

(* ---- Channel 8  (Slot 4 Ch00) ---- *)
CM_AIN[8].PV := INT_TO_REAL(CM_AIN[8].IN);
IF CM_AIN[8].MODE THEN CM_AIN[8].PV := CM_AIN[8].PV_SIM; END_IF;
CM_AIN[8].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[8].ALARMTIME * 1000.0);
CM_AIN[8].ALARMDELAY.EnableIn := ((CM_AIN[8].PV >= CM_AIN[8].HHAL AND CM_AIN[8].HHEN AND CM_AIN[8].HHEN_PRG) OR
                                   (CM_AIN[8].PV >= CM_AIN[8].HAL  AND CM_AIN[8].HEN  AND CM_AIN[8].HEN_PRG)  OR
                                   (CM_AIN[8].PV <= CM_AIN[8].LAL  AND CM_AIN[8].LEN  AND CM_AIN[8].LEN_PRG)  OR
                                   (CM_AIN[8].PV <= CM_AIN[8].LLAL AND CM_AIN[8].LLEN AND CM_AIN[8].LLEN_PRG)) AND NOT CM_AIN[8].BAD;
TONR(CM_AIN[8].ALARMDELAY);
IF CM_AIN[8].ALARMDELAY.DN AND NOT CM_AIN[8].BAD THEN
    IF CM_AIN[8].PV >= CM_AIN[8].HHAL AND CM_AIN[8].HHEN AND CM_AIN[8].HHEN_PRG THEN CM_AIN[8].HHAI := 1; END_IF;
    IF CM_AIN[8].PV >= CM_AIN[8].HAL  AND CM_AIN[8].HEN  AND CM_AIN[8].HEN_PRG  THEN CM_AIN[8].HAI  := 1; END_IF;
    IF CM_AIN[8].PV <= CM_AIN[8].LAL  AND CM_AIN[8].LEN  AND CM_AIN[8].LEN_PRG  THEN CM_AIN[8].LAI  := 1; END_IF;
    IF CM_AIN[8].PV <= CM_AIN[8].LLAL AND CM_AIN[8].LLEN AND CM_AIN[8].LLEN_PRG THEN CM_AIN[8].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[8].PV < (CM_AIN[8].HHAL - CM_AIN[8].ALMDB) THEN CM_AIN[8].HHAI := 0; END_IF;
IF CM_AIN[8].PV < (CM_AIN[8].HAL  - CM_AIN[8].ALMDB) THEN CM_AIN[8].HAI  := 0; END_IF;
IF CM_AIN[8].PV > (CM_AIN[8].LAL  + CM_AIN[8].ALMDB) THEN CM_AIN[8].LAI  := 0; END_IF;
IF CM_AIN[8].PV > (CM_AIN[8].LLAL + CM_AIN[8].ALMDB) THEN CM_AIN[8].LLAI := 0; END_IF;
IF CM_AIN[8].BAD THEN CM_AIN[8].HHAI := 0; CM_AIN[8].HAI := 0; CM_AIN[8].LAI := 0; CM_AIN[8].LLAI := 0; END_IF;
CM_AIN[8].ALARM := CM_AIN[8].HHAI OR CM_AIN[8].HAI OR CM_AIN[8].LAI OR CM_AIN[8].LLAI;
IF CM_AIN[8].HHAI THEN CM_AIN[8].ALMpri := 1;
ELSIF CM_AIN[8].LLAI THEN CM_AIN[8].ALMpri := 2;
ELSIF CM_AIN[8].HAI  THEN CM_AIN[8].ALMpri := 3;
ELSIF CM_AIN[8].LAI  THEN CM_AIN[8].ALMpri := 4;
ELSE CM_AIN[8].ALMpri := 5;
END_IF;
IF CM_AIN[8].ACK THEN CM_AIN[8].ACKD := 1; CM_AIN[8].BLINK := 0; CM_AIN[8].ACK := 0; END_IF;

(* ---- Channel 9  (Slot 4 Ch01) ---- *)
CM_AIN[9].PV := INT_TO_REAL(CM_AIN[9].IN);
IF CM_AIN[9].MODE THEN CM_AIN[9].PV := CM_AIN[9].PV_SIM; END_IF;
CM_AIN[9].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[9].ALARMTIME * 1000.0);
CM_AIN[9].ALARMDELAY.EnableIn := ((CM_AIN[9].PV >= CM_AIN[9].HHAL AND CM_AIN[9].HHEN AND CM_AIN[9].HHEN_PRG) OR
                                   (CM_AIN[9].PV >= CM_AIN[9].HAL  AND CM_AIN[9].HEN  AND CM_AIN[9].HEN_PRG)  OR
                                   (CM_AIN[9].PV <= CM_AIN[9].LAL  AND CM_AIN[9].LEN  AND CM_AIN[9].LEN_PRG)  OR
                                   (CM_AIN[9].PV <= CM_AIN[9].LLAL AND CM_AIN[9].LLEN AND CM_AIN[9].LLEN_PRG)) AND NOT CM_AIN[9].BAD;
TONR(CM_AIN[9].ALARMDELAY);
IF CM_AIN[9].ALARMDELAY.DN AND NOT CM_AIN[9].BAD THEN
    IF CM_AIN[9].PV >= CM_AIN[9].HHAL AND CM_AIN[9].HHEN AND CM_AIN[9].HHEN_PRG THEN CM_AIN[9].HHAI := 1; END_IF;
    IF CM_AIN[9].PV >= CM_AIN[9].HAL  AND CM_AIN[9].HEN  AND CM_AIN[9].HEN_PRG  THEN CM_AIN[9].HAI  := 1; END_IF;
    IF CM_AIN[9].PV <= CM_AIN[9].LAL  AND CM_AIN[9].LEN  AND CM_AIN[9].LEN_PRG  THEN CM_AIN[9].LAI  := 1; END_IF;
    IF CM_AIN[9].PV <= CM_AIN[9].LLAL AND CM_AIN[9].LLEN AND CM_AIN[9].LLEN_PRG THEN CM_AIN[9].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[9].PV < (CM_AIN[9].HHAL - CM_AIN[9].ALMDB) THEN CM_AIN[9].HHAI := 0; END_IF;
IF CM_AIN[9].PV < (CM_AIN[9].HAL  - CM_AIN[9].ALMDB) THEN CM_AIN[9].HAI  := 0; END_IF;
IF CM_AIN[9].PV > (CM_AIN[9].LAL  + CM_AIN[9].ALMDB) THEN CM_AIN[9].LAI  := 0; END_IF;
IF CM_AIN[9].PV > (CM_AIN[9].LLAL + CM_AIN[9].ALMDB) THEN CM_AIN[9].LLAI := 0; END_IF;
IF CM_AIN[9].BAD THEN CM_AIN[9].HHAI := 0; CM_AIN[9].HAI := 0; CM_AIN[9].LAI := 0; CM_AIN[9].LLAI := 0; END_IF;
CM_AIN[9].ALARM := CM_AIN[9].HHAI OR CM_AIN[9].HAI OR CM_AIN[9].LAI OR CM_AIN[9].LLAI;
IF CM_AIN[9].HHAI THEN CM_AIN[9].ALMpri := 1;
ELSIF CM_AIN[9].LLAI THEN CM_AIN[9].ALMpri := 2;
ELSIF CM_AIN[9].HAI  THEN CM_AIN[9].ALMpri := 3;
ELSIF CM_AIN[9].LAI  THEN CM_AIN[9].ALMpri := 4;
ELSE CM_AIN[9].ALMpri := 5;
END_IF;
IF CM_AIN[9].ACK THEN CM_AIN[9].ACKD := 1; CM_AIN[9].BLINK := 0; CM_AIN[9].ACK := 0; END_IF;

(* ---- Channel 10 (Slot 4 Ch02) ---- *)
CM_AIN[10].PV := INT_TO_REAL(CM_AIN[10].IN);
IF CM_AIN[10].MODE THEN CM_AIN[10].PV := CM_AIN[10].PV_SIM; END_IF;
CM_AIN[10].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[10].ALARMTIME * 1000.0);
CM_AIN[10].ALARMDELAY.EnableIn := ((CM_AIN[10].PV >= CM_AIN[10].HHAL AND CM_AIN[10].HHEN AND CM_AIN[10].HHEN_PRG) OR
                                    (CM_AIN[10].PV >= CM_AIN[10].HAL  AND CM_AIN[10].HEN  AND CM_AIN[10].HEN_PRG)  OR
                                    (CM_AIN[10].PV <= CM_AIN[10].LAL  AND CM_AIN[10].LEN  AND CM_AIN[10].LEN_PRG)  OR
                                    (CM_AIN[10].PV <= CM_AIN[10].LLAL AND CM_AIN[10].LLEN AND CM_AIN[10].LLEN_PRG)) AND NOT CM_AIN[10].BAD;
TONR(CM_AIN[10].ALARMDELAY);
IF CM_AIN[10].ALARMDELAY.DN AND NOT CM_AIN[10].BAD THEN
    IF CM_AIN[10].PV >= CM_AIN[10].HHAL AND CM_AIN[10].HHEN AND CM_AIN[10].HHEN_PRG THEN CM_AIN[10].HHAI := 1; END_IF;
    IF CM_AIN[10].PV >= CM_AIN[10].HAL  AND CM_AIN[10].HEN  AND CM_AIN[10].HEN_PRG  THEN CM_AIN[10].HAI  := 1; END_IF;
    IF CM_AIN[10].PV <= CM_AIN[10].LAL  AND CM_AIN[10].LEN  AND CM_AIN[10].LEN_PRG  THEN CM_AIN[10].LAI  := 1; END_IF;
    IF CM_AIN[10].PV <= CM_AIN[10].LLAL AND CM_AIN[10].LLEN AND CM_AIN[10].LLEN_PRG THEN CM_AIN[10].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[10].PV < (CM_AIN[10].HHAL - CM_AIN[10].ALMDB) THEN CM_AIN[10].HHAI := 0; END_IF;
IF CM_AIN[10].PV < (CM_AIN[10].HAL  - CM_AIN[10].ALMDB) THEN CM_AIN[10].HAI  := 0; END_IF;
IF CM_AIN[10].PV > (CM_AIN[10].LAL  + CM_AIN[10].ALMDB) THEN CM_AIN[10].LAI  := 0; END_IF;
IF CM_AIN[10].PV > (CM_AIN[10].LLAL + CM_AIN[10].ALMDB) THEN CM_AIN[10].LLAI := 0; END_IF;
IF CM_AIN[10].BAD THEN CM_AIN[10].HHAI := 0; CM_AIN[10].HAI := 0; CM_AIN[10].LAI := 0; CM_AIN[10].LLAI := 0; END_IF;
CM_AIN[10].ALARM := CM_AIN[10].HHAI OR CM_AIN[10].HAI OR CM_AIN[10].LAI OR CM_AIN[10].LLAI;
IF CM_AIN[10].HHAI THEN CM_AIN[10].ALMpri := 1;
ELSIF CM_AIN[10].LLAI THEN CM_AIN[10].ALMpri := 2;
ELSIF CM_AIN[10].HAI  THEN CM_AIN[10].ALMpri := 3;
ELSIF CM_AIN[10].LAI  THEN CM_AIN[10].ALMpri := 4;
ELSE CM_AIN[10].ALMpri := 5;
END_IF;
IF CM_AIN[10].ACK THEN CM_AIN[10].ACKD := 1; CM_AIN[10].BLINK := 0; CM_AIN[10].ACK := 0; END_IF;

(* ---- Channel 11 (Slot 4 Ch03) ---- *)
