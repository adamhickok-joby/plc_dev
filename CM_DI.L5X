<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.00" TargetName="GeneralPanel_Foundation" TargetType="Controller" ContainsContext="true">
  <Controller Use="Context" Name="GeneralPanel_Foundation">
    <Programs Use="Context">
      <Program Name="MainProgram" Use="Context">
        <Routines Use="Context">

          <Routine Name="CM_DI" Type="ST">
            <STContent>
              <![CDATA[
(* ============================================================
   CM_DI — Discrete Input alarm processing
   Channels: CM_DIN[0..15] (Slot 1 IB16)
   ============================================================ *)

(* ---- Channel 0 ---- *)
IF CM_DIN[0].ALARM_DISABLE THEN
    CM_DIN[0].ALARM := 0;
ELSE
    CM_DIN[0].ALARMDELAY.PRE := REAL_TO_DINT(CM_DIN[0].ALARMTIME * 1000.0);
    CM_DIN[0].ALARMDELAY.EnableIn := CM_DIN[0].IN XOR CM_DIN[0].NC;
    TONR(CM_DIN[0].ALARMDELAY);
    IF CM_DIN[0].ALARMDELAY.DN THEN CM_DIN[0].ALARM := 1; END_IF;
    IF NOT (CM_DIN[0].IN XOR CM_DIN[0].NC) THEN CM_DIN[0].ALARM := 0; END_IF;
    IF CM_DIN[0].ACK THEN CM_DIN[0].ACKD := 1; CM_DIN[0].ACK := 0; END_IF;
    IF CM_DIN[0].INTERMITTENT THEN
        CM_DIN[0].INTERMIT_DELAY.PRE := CM_DIN[0].INTERMIT_TIME;
        CM_DIN[0].INTERMIT_DELAY.EnableIn := NOT CM_DIN[0].IN;
        TONR(CM_DIN[0].INTERMIT_DELAY);
        CM_DIN[0].INTERMIT_COUNT.PRE := 5;
        CM_DIN[0].INTERMIT_COUNT.CU := CM_DIN[0].IN;
        CM_DIN[0].INTERMIT_COUNT.CD := CM_DIN[0].INTERMIT_DELAY.DN;
        CTUD(CM_DIN[0].INTERMIT_COUNT);
    END_IF;
END_IF;

(* ---- Channel 1 ---- *)
IF CM_DIN[1].ALARM_DISABLE THEN
    CM_DIN[1].ALARM := 0;
