          <Routine Name="MainRoutine" Type="ST">
            <STContent>
              <![CDATA[
(* ============================================================
   MainRoutine — R&D General Panel Foundation
   Controller: 5069-L320ER  IP: 192.168.1.11  FW: v36.11
   JSR calls only — no inline logic.
   ============================================================ *)

