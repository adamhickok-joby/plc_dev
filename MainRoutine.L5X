JSR(CM_AI);           (* Step 3: Analog input processing (Slot 3 IF8) *)
JSR(CM_TC);           (* Step 4: Thermocouple processing (Slots 4-6 IY4) *)
JSR(CM_DO);           (* Step 5: Discrete output / solenoid valve control *)

(* Step 6 — PROJECT-SPECIFIC ROUTINES — add JSR calls here per project *)

JSR(CM_ALARMS_AGG);   (* Step 7: Alarm aggregate rollup *)
]]>
