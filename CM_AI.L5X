<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.00" TargetName="GeneralPanel_Foundation" TargetType="Controller" ContainsContext="true">
  <Controller Use="Context" Name="GeneralPanel_Foundation">
    <Programs Use="Context">
      <Program Name="MainProgram" Use="Context">
        <Routines Use="Context">

          <Routine Name="CM_AI" Type="ST">
            <STContent>
              <![CDATA[
(* ============================================================
   CM_AI — Analog Input processing (Slot 3 IF8, 4-20 mA)
   Channels: CM_AIN[0..7]
   CONV modes: 0=4-20mA linear  1=Scale+Offset  2=Pass-through
   ============================================================ *)

(* ---- Channel 0 ---- *)
IF CM_AIN[0].CONV = 0 THEN
    CM_AIN[0].PV := CM_AIN[0].EULO + ((INT_TO_REAL(CM_AIN[0].IN) - 3277.0) / (16383.0 - 3277.0)) * (CM_AIN[0].EUHI - CM_AIN[0].EULO);
ELSIF CM_AIN[0].CONV = 1 THEN
    CM_AIN[0].PV := (CM_AIN[0].SCALE * INT_TO_REAL(CM_AIN[0].IN)) + CM_AIN[0].OFFSET;
ELSE
    CM_AIN[0].PV := INT_TO_REAL(CM_AIN[0].IN);
END_IF;
IF CM_AIN[0].MODE THEN CM_AIN[0].PV := CM_AIN[0].PV_SIM; END_IF;
CM_AIN[0].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[0].ALARMTIME * 1000.0);
CM_AIN[0].ALARMDELAY.EnableIn := ((CM_AIN[0].PV >= CM_AIN[0].HHAL AND CM_AIN[0].HHEN AND CM_AIN[0].HHEN_PRG) OR
                                   (CM_AIN[0].PV >= CM_AIN[0].HAL  AND CM_AIN[0].HEN  AND CM_AIN[0].HEN_PRG)  OR
                                   (CM_AIN[0].PV <= CM_AIN[0].LAL  AND CM_AIN[0].LEN  AND CM_AIN[0].LEN_PRG)  OR
                                   (CM_AIN[0].PV <= CM_AIN[0].LLAL AND CM_AIN[0].LLEN AND CM_AIN[0].LLEN_PRG)) AND NOT CM_AIN[0].BAD;
TONR(CM_AIN[0].ALARMDELAY);
IF CM_AIN[0].ALARMDELAY.DN AND NOT CM_AIN[0].BAD THEN
    IF CM_AIN[0].PV >= CM_AIN[0].HHAL AND CM_AIN[0].HHEN AND CM_AIN[0].HHEN_PRG THEN CM_AIN[0].HHAI := 1; END_IF;
    IF CM_AIN[0].PV >= CM_AIN[0].HAL  AND CM_AIN[0].HEN  AND CM_AIN[0].HEN_PRG  THEN CM_AIN[0].HAI  := 1; END_IF;
    IF CM_AIN[0].PV <= CM_AIN[0].LAL  AND CM_AIN[0].LEN  AND CM_AIN[0].LEN_PRG  THEN CM_AIN[0].LAI  := 1; END_IF;
    IF CM_AIN[0].PV <= CM_AIN[0].LLAL AND CM_AIN[0].LLEN AND CM_AIN[0].LLEN_PRG THEN CM_AIN[0].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[0].PV < (CM_AIN[0].HHAL - CM_AIN[0].ALMDB) THEN CM_AIN[0].HHAI := 0; END_IF;
IF CM_AIN[0].PV < (CM_AIN[0].HAL  - CM_AIN[0].ALMDB) THEN CM_AIN[0].HAI  := 0; END_IF;
IF CM_AIN[0].PV > (CM_AIN[0].LAL  + CM_AIN[0].ALMDB) THEN CM_AIN[0].LAI  := 0; END_IF;
IF CM_AIN[0].PV > (CM_AIN[0].LLAL + CM_AIN[0].ALMDB) THEN CM_AIN[0].LLAI := 0; END_IF;
IF CM_AIN[0].BAD THEN CM_AIN[0].HHAI := 0; CM_AIN[0].HAI := 0; CM_AIN[0].LAI := 0; CM_AIN[0].LLAI := 0; END_IF;
CM_AIN[0].ALARM := CM_AIN[0].HHAI OR CM_AIN[0].HAI OR CM_AIN[0].LAI OR CM_AIN[0].LLAI;
IF CM_AIN[0].HHAI THEN CM_AIN[0].ALMpri := 1;
ELSIF CM_AIN[0].LLAI THEN CM_AIN[0].ALMpri := 2;
ELSIF CM_AIN[0].HAI  THEN CM_AIN[0].ALMpri := 3;
ELSIF CM_AIN[0].LAI  THEN CM_AIN[0].ALMpri := 4;
ELSE CM_AIN[0].ALMpri := 5;
END_IF;
IF CM_AIN[0].ACK THEN CM_AIN[0].ACKD := 1; CM_AIN[0].BLINK := 0; CM_AIN[0].ACK := 0; END_IF;

(* ---- Channel 1 ---- *)
IF CM_AIN[1].CONV = 0 THEN
    CM_AIN[1].PV := CM_AIN[1].EULO + ((INT_TO_REAL(CM_AIN[1].IN) - 3277.0) / (16383.0 - 3277.0)) * (CM_AIN[1].EUHI - CM_AIN[1].EULO);
ELSIF CM_AIN[1].CONV = 1 THEN
    CM_AIN[1].PV := (CM_AIN[1].SCALE * INT_TO_REAL(CM_AIN[1].IN)) + CM_AIN[1].OFFSET;
ELSE
    CM_AIN[1].PV := INT_TO_REAL(CM_AIN[1].IN);
END_IF;
IF CM_AIN[1].MODE THEN CM_AIN[1].PV := CM_AIN[1].PV_SIM; END_IF;
CM_AIN[1].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[1].ALARMTIME * 1000.0);
CM_AIN[1].ALARMDELAY.EnableIn := ((CM_AIN[1].PV >= CM_AIN[1].HHAL AND CM_AIN[1].HHEN AND CM_AIN[1].HHEN_PRG) OR
                                   (CM_AIN[1].PV >= CM_AIN[1].HAL  AND CM_AIN[1].HEN  AND CM_AIN[1].HEN_PRG)  OR
                                   (CM_AIN[1].PV <= CM_AIN[1].LAL  AND CM_AIN[1].LEN  AND CM_AIN[1].LEN_PRG)  OR
                                   (CM_AIN[1].PV <= CM_AIN[1].LLAL AND CM_AIN[1].LLEN AND CM_AIN[1].LLEN_PRG)) AND NOT CM_AIN[1].BAD;
TONR(CM_AIN[1].ALARMDELAY);
IF CM_AIN[1].ALARMDELAY.DN AND NOT CM_AIN[1].BAD THEN
    IF CM_AIN[1].PV >= CM_AIN[1].HHAL AND CM_AIN[1].HHEN AND CM_AIN[1].HHEN_PRG THEN CM_AIN[1].HHAI := 1; END_IF;
    IF CM_AIN[1].PV >= CM_AIN[1].HAL  AND CM_AIN[1].HEN  AND CM_AIN[1].HEN_PRG  THEN CM_AIN[1].HAI  := 1; END_IF;
    IF CM_AIN[1].PV <= CM_AIN[1].LAL  AND CM_AIN[1].LEN  AND CM_AIN[1].LEN_PRG  THEN CM_AIN[1].LAI  := 1; END_IF;
    IF CM_AIN[1].PV <= CM_AIN[1].LLAL AND CM_AIN[1].LLEN AND CM_AIN[1].LLEN_PRG THEN CM_AIN[1].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[1].PV < (CM_AIN[1].HHAL - CM_AIN[1].ALMDB) THEN CM_AIN[1].HHAI := 0; END_IF;
IF CM_AIN[1].PV < (CM_AIN[1].HAL  - CM_AIN[1].ALMDB) THEN CM_AIN[1].HAI  := 0; END_IF;
IF CM_AIN[1].PV > (CM_AIN[1].LAL  + CM_AIN[1].ALMDB) THEN CM_AIN[1].LAI  := 0; END_IF;
IF CM_AIN[1].PV > (CM_AIN[1].LLAL + CM_AIN[1].ALMDB) THEN CM_AIN[1].LLAI := 0; END_IF;
IF CM_AIN[1].BAD THEN CM_AIN[1].HHAI := 0; CM_AIN[1].HAI := 0; CM_AIN[1].LAI := 0; CM_AIN[1].LLAI := 0; END_IF;
CM_AIN[1].ALARM := CM_AIN[1].HHAI OR CM_AIN[1].HAI OR CM_AIN[1].LAI OR CM_AIN[1].LLAI;
IF CM_AIN[1].HHAI THEN CM_AIN[1].ALMpri := 1;
ELSIF CM_AIN[1].LLAI THEN CM_AIN[1].ALMpri := 2;
ELSIF CM_AIN[1].HAI  THEN CM_AIN[1].ALMpri := 3;
ELSIF CM_AIN[1].LAI  THEN CM_AIN[1].ALMpri := 4;
ELSE CM_AIN[1].ALMpri := 5;
END_IF;
IF CM_AIN[1].ACK THEN CM_AIN[1].ACKD := 1; CM_AIN[1].BLINK := 0; CM_AIN[1].ACK := 0; END_IF;

(* ---- Channel 2 ---- *)
IF CM_AIN[2].CONV = 0 THEN
    CM_AIN[2].PV := CM_AIN[2].EULO + ((INT_TO_REAL(CM_AIN[2].IN) - 3277.0) / (16383.0 - 3277.0)) * (CM_AIN[2].EUHI - CM_AIN[2].EULO);
ELSIF CM_AIN[2].CONV = 1 THEN
    CM_AIN[2].PV := (CM_AIN[2].SCALE * INT_TO_REAL(CM_AIN[2].IN)) + CM_AIN[2].OFFSET;
ELSE
    CM_AIN[2].PV := INT_TO_REAL(CM_AIN[2].IN);
END_IF;
IF CM_AIN[2].MODE THEN CM_AIN[2].PV := CM_AIN[2].PV_SIM; END_IF;
CM_AIN[2].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[2].ALARMTIME * 1000.0);
CM_AIN[2].ALARMDELAY.EnableIn := ((CM_AIN[2].PV >= CM_AIN[2].HHAL AND CM_AIN[2].HHEN AND CM_AIN[2].HHEN_PRG) OR
                                   (CM_AIN[2].PV >= CM_AIN[2].HAL  AND CM_AIN[2].HEN  AND CM_AIN[2].HEN_PRG)  OR
                                   (CM_AIN[2].PV <= CM_AIN[2].LAL  AND CM_AIN[2].LEN  AND CM_AIN[2].LEN_PRG)  OR
                                   (CM_AIN[2].PV <= CM_AIN[2].LLAL AND CM_AIN[2].LLEN AND CM_AIN[2].LLEN_PRG)) AND NOT CM_AIN[2].BAD;
TONR(CM_AIN[2].ALARMDELAY);
IF CM_AIN[2].ALARMDELAY.DN AND NOT CM_AIN[2].BAD THEN
    IF CM_AIN[2].PV >= CM_AIN[2].HHAL AND CM_AIN[2].HHEN AND CM_AIN[2].HHEN_PRG THEN CM_AIN[2].HHAI := 1; END_IF;
    IF CM_AIN[2].PV >= CM_AIN[2].HAL  AND CM_AIN[2].HEN  AND CM_AIN[2].HEN_PRG  THEN CM_AIN[2].HAI  := 1; END_IF;
    IF CM_AIN[2].PV <= CM_AIN[2].LAL  AND CM_AIN[2].LEN  AND CM_AIN[2].LEN_PRG  THEN CM_AIN[2].LAI  := 1; END_IF;
    IF CM_AIN[2].PV <= CM_AIN[2].LLAL AND CM_AIN[2].LLEN AND CM_AIN[2].LLEN_PRG THEN CM_AIN[2].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[2].PV < (CM_AIN[2].HHAL - CM_AIN[2].ALMDB) THEN CM_AIN[2].HHAI := 0; END_IF;
IF CM_AIN[2].PV < (CM_AIN[2].HAL  - CM_AIN[2].ALMDB) THEN CM_AIN[2].HAI  := 0; END_IF;
IF CM_AIN[2].PV > (CM_AIN[2].LAL  + CM_AIN[2].ALMDB) THEN CM_AIN[2].LAI  := 0; END_IF;
IF CM_AIN[2].PV > (CM_AIN[2].LLAL + CM_AIN[2].ALMDB) THEN CM_AIN[2].LLAI := 0; END_IF;
IF CM_AIN[2].BAD THEN CM_AIN[2].HHAI := 0; CM_AIN[2].HAI := 0; CM_AIN[2].LAI := 0; CM_AIN[2].LLAI := 0; END_IF;
