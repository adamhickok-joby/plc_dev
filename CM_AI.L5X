    IF CM_AIN[4].PV >= CM_AIN[4].HAL  AND CM_AIN[4].HEN  AND CM_AIN[4].HEN_PRG  THEN CM_AIN[4].HAI  := 1; END_IF;
    IF CM_AIN[4].PV <= CM_AIN[4].LAL  AND CM_AIN[4].LEN  AND CM_AIN[4].LEN_PRG  THEN CM_AIN[4].LAI  := 1; END_IF;
