    IF CM_AIN[6].PV >= CM_AIN[6].HHAL AND CM_AIN[6].HHEN AND CM_AIN[6].HHEN_PRG THEN CM_AIN[6].HHAI := 1; END_IF;
    IF CM_AIN[6].PV >= CM_AIN[6].HAL  AND CM_AIN[6].HEN  AND CM_AIN[6].HEN_PRG  THEN CM_AIN[6].HAI  := 1; END_IF;
    IF CM_AIN[6].PV <= CM_AIN[6].LAL  AND CM_AIN[6].LEN  AND CM_AIN[6].LEN_PRG  THEN CM_AIN[6].LAI  := 1; END_IF;
    IF CM_AIN[6].PV <= CM_AIN[6].LLAL AND CM_AIN[6].LLEN AND CM_AIN[6].LLEN_PRG THEN CM_AIN[6].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[6].PV < (CM_AIN[6].HHAL - CM_AIN[6].ALMDB) THEN CM_AIN[6].HHAI := 0; END_IF;
IF CM_AIN[6].PV < (CM_AIN[6].HAL  - CM_AIN[6].ALMDB) THEN CM_AIN[6].HAI  := 0; END_IF;
IF CM_AIN[6].PV > (CM_AIN[6].LAL  + CM_AIN[6].ALMDB) THEN CM_AIN[6].LAI  := 0; END_IF;
IF CM_AIN[6].PV > (CM_AIN[6].LLAL + CM_AIN[6].ALMDB) THEN CM_AIN[6].LLAI := 0; END_IF;
IF CM_AIN[6].BAD THEN CM_AIN[6].HHAI := 0; CM_AIN[6].HAI := 0; CM_AIN[6].LAI := 0; CM_AIN[6].LLAI := 0; END_IF;
CM_AIN[6].ALARM := CM_AIN[6].HHAI OR CM_AIN[6].HAI OR CM_AIN[6].LAI OR CM_AIN[6].LLAI;
IF CM_AIN[6].HHAI THEN CM_AIN[6].ALMpri := 1;
ELSIF CM_AIN[6].LLAI THEN CM_AIN[6].ALMpri := 2;
ELSIF CM_AIN[6].HAI  THEN CM_AIN[6].ALMpri := 3;
ELSIF CM_AIN[6].LAI  THEN CM_AIN[6].ALMpri := 4;
ELSE CM_AIN[6].ALMpri := 5;
END_IF;
IF CM_AIN[6].ACK THEN CM_AIN[6].ACKD := 1; CM_AIN[6].BLINK := 0; CM_AIN[6].ACK := 0; END_IF;

(* ---- Channel 7 ---- *)
IF CM_AIN[7].CONV = 0 THEN
    CM_AIN[7].PV := CM_AIN[7].EULO + ((INT_TO_REAL(CM_AIN[7].IN) - 3277.0) / (16383.0 - 3277.0)) * (CM_AIN[7].EUHI - CM_AIN[7].EULO);
ELSIF CM_AIN[7].CONV = 1 THEN
    CM_AIN[7].PV := (CM_AIN[7].SCALE * INT_TO_REAL(CM_AIN[7].IN)) + CM_AIN[7].OFFSET;
ELSE
    CM_AIN[7].PV := INT_TO_REAL(CM_AIN[7].IN);
END_IF;
IF CM_AIN[7].MODE THEN CM_AIN[7].PV := CM_AIN[7].PV_SIM; END_IF;
CM_AIN[7].ALARMDELAY.PRE := REAL_TO_DINT(CM_AIN[7].ALARMTIME * 1000.0);
CM_AIN[7].ALARMDELAY.EnableIn := ((CM_AIN[7].PV >= CM_AIN[7].HHAL AND CM_AIN[7].HHEN AND CM_AIN[7].HHEN_PRG) OR
                                   (CM_AIN[7].PV >= CM_AIN[7].HAL  AND CM_AIN[7].HEN  AND CM_AIN[7].HEN_PRG)  OR
                                   (CM_AIN[7].PV <= CM_AIN[7].LAL  AND CM_AIN[7].LEN  AND CM_AIN[7].LEN_PRG)  OR
                                   (CM_AIN[7].PV <= CM_AIN[7].LLAL AND CM_AIN[7].LLEN AND CM_AIN[7].LLEN_PRG)) AND NOT CM_AIN[7].BAD;
TONR(CM_AIN[7].ALARMDELAY);
IF CM_AIN[7].ALARMDELAY.DN AND NOT CM_AIN[7].BAD THEN
    IF CM_AIN[7].PV >= CM_AIN[7].HHAL AND CM_AIN[7].HHEN AND CM_AIN[7].HHEN_PRG THEN CM_AIN[7].HHAI := 1; END_IF;
    IF CM_AIN[7].PV >= CM_AIN[7].HAL  AND CM_AIN[7].HEN  AND CM_AIN[7].HEN_PRG  THEN CM_AIN[7].HAI  := 1; END_IF;
    IF CM_AIN[7].PV <= CM_AIN[7].LAL  AND CM_AIN[7].LEN  AND CM_AIN[7].LEN_PRG  THEN CM_AIN[7].LAI  := 1; END_IF;
    IF CM_AIN[7].PV <= CM_AIN[7].LLAL AND CM_AIN[7].LLEN AND CM_AIN[7].LLEN_PRG THEN CM_AIN[7].LLAI := 1; END_IF;
END_IF;
IF CM_AIN[7].PV < (CM_AIN[7].HHAL - CM_AIN[7].ALMDB) THEN CM_AIN[7].HHAI := 0; END_IF;
IF CM_AIN[7].PV < (CM_AIN[7].HAL  - CM_AIN[7].ALMDB) THEN CM_AIN[7].HAI  := 0; END_IF;
IF CM_AIN[7].PV > (CM_AIN[7].LAL  + CM_AIN[7].ALMDB) THEN CM_AIN[7].LAI  := 0; END_IF;
IF CM_AIN[7].PV > (CM_AIN[7].LLAL + CM_AIN[7].ALMDB) THEN CM_AIN[7].LLAI := 0; END_IF;
IF CM_AIN[7].BAD THEN CM_AIN[7].HHAI := 0; CM_AIN[7].HAI := 0; CM_AIN[7].LAI := 0; CM_AIN[7].LLAI := 0; END_IF;
CM_AIN[7].ALARM := CM_AIN[7].HHAI OR CM_AIN[7].HAI OR CM_AIN[7].LAI OR CM_AIN[7].LLAI;
IF CM_AIN[7].HHAI THEN CM_AIN[7].ALMpri := 1;
ELSIF CM_AIN[7].LLAI THEN CM_AIN[7].ALMpri := 2;
ELSIF CM_AIN[7].HAI  THEN CM_AIN[7].ALMpri := 3;
ELSIF CM_AIN[7].LAI  THEN CM_AIN[7].ALMpri := 4;
ELSE CM_AIN[7].ALMpri := 5;
END_IF;
IF CM_AIN[7].ACK THEN CM_AIN[7].ACKD := 1; CM_AIN[7].BLINK := 0; CM_AIN[7].ACK := 0; END_IF;
]]>
            </STContent>
          </Routine>

        </Routines>
      </Program>
    </Programs>
  </Controller>
</RSLogix5000Content>
