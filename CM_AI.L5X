    CM_AIN[4].PV := CM_AIN[4].EULO + ((INT_TO_REAL(CM_AIN[4].IN) - 3277.0) / (16383.0 - 3277.0)) * (CM_AIN[4].EUHI - CM_AIN[4].EULO);
ELSIF CM_AIN[4].CONV = 1 THEN
