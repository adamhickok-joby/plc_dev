    IF CM_AIN[3].PV <= CM_AIN[3].LAL  AND CM_AIN[3].LEN  AND CM_AIN[3].LEN_PRG  THEN CM_AIN[3].LAI  := 1; END_IF;
    IF CM_AIN[3].PV <= CM_AIN[3].LLAL AND CM_AIN[3].LLEN AND CM_AIN[3].LLEN_PRG THEN CM_AIN[3].LLAI := 1; END_IF;
